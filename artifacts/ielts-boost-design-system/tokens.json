{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f3eee4" },
      "foreground": { "$value": "#17332a" },
      "border": { "$value": "#dcd3c0" },
      "card": { "$value": "#fffdf8" },
      "cardForeground": { "$value": "#17332a" },
      "popover": { "$value": "#fffdf8" },
      "popoverForeground": { "$value": "#17332a" },
      "primary": {
        "$value": "#c83c25",
        "$description": "The source terracotta is slightly deepened so light button text reaches readable contrast."
      },
      "primaryForeground": { "$value": "#fffdf8" },
      "secondary": { "$value": "#ece3cf" },
      "secondaryForeground": { "$value": "#17332a" },
      "muted": { "$value": "#ece3cf" },
      "mutedForeground": { "$value": "#68776f" },
      "accent": { "$value": "#1d7a52" },
      "accentForeground": { "$value": "#ffffff" },
      "destructive": { "$value": "#c03924" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#dcd3c0" },
      "ring": { "$value": "#c83c25" },
      "chart1": { "$value": "#c83c25" },
      "chart2": { "$value": "#1d7a52" },
      "chart3": { "$value": "#17332a" },
      "chart4": { "$value": "#c48b25" },
      "chart5": { "$value": "#927156" },
      "sidebar": { "$value": "#fffdf8" },
      "sidebarForeground": { "$value": "#17332a" },
      "sidebarBorder": { "$value": "#dcd3c0" },
      "sidebarPrimary": { "$value": "#c83c25" },
      "sidebarPrimaryForeground": { "$value": "#fffdf8" },
      "sidebarAccent": { "$value": "#ece3cf" },
      "sidebarAccentForeground": { "$value": "#17332a" },
      "sidebarRing": { "$value": "#c83c25" }
    },
    "dark": {
      "background": { "$value": "#0d1a16" },
      "foreground": { "$value": "#e8efe9" },
      "border": { "$value": "#264037" },
      "card": { "$value": "#15261f" },
      "cardForeground": { "$value": "#e8efe9" },
      "popover": { "$value": "#15261f" },
      "popoverForeground": { "$value": "#e8efe9" },
      "primary": { "$value": "#ff7a59" },
      "primaryForeground": { "$value": "#0d1a16" },
      "secondary": { "$value": "#1c3128" },
      "secondaryForeground": { "$value": "#e8efe9" },
      "muted": { "$value": "#1c3128" },
      "mutedForeground": { "$value": "#8fa398" },
      "accent": { "$value": "#4fcf93" },
      "accentForeground": { "$value": "#0d1a16" },
      "destructive": { "$value": "#ff7a59" },
      "destructiveForeground": { "$value": "#0d1a16" },
      "input": { "$value": "#264037" },
      "ring": { "$value": "#ff7a59" },
      "chart1": { "$value": "#ff7a59" },
      "chart2": { "$value": "#4fcf93" },
      "chart3": { "$value": "#e8efe9" },
      "chart4": { "$value": "#e4b04a" },
      "chart5": { "$value": "#9ebfac" },
      "sidebar": { "$value": "#15261f" },
      "sidebarForeground": { "$value": "#e8efe9" },
      "sidebarBorder": { "$value": "#264037" },
      "sidebarPrimary": { "$value": "#ff7a59" },
      "sidebarPrimaryForeground": { "$value": "#0d1a16" },
      "sidebarAccent": { "$value": "#1c3128" },
      "sidebarAccentForeground": { "$value": "#e8efe9" },
      "sidebarRing": { "$value": "#ff7a59" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["system-ui", "-apple-system", "Segoe UI", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["ui-monospace", "Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
