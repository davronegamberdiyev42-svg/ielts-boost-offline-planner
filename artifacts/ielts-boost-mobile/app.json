{
  "expo": {
    "name": "IELTS Boost",
    "slug": "ielts-boost-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ielts-boost-mobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#f3eee4"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Ovozli javoblaringizni yozish uchun mikrofonga ruxsat bering."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
